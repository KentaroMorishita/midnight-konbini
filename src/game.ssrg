import * as dom from "std/web/dom"
import * as html from "std/web/html"
import * as signals from "std/signal"
import { MutableSignal, Signal } from "std/signal"
import {
  clerkMale,
  clerkFemale,
  shopperMaleOffice,
  shopperFemaleAdult,
  shopperMaleStudent,
  atm,
  autoDoor,
  coffeeMachine,
  freezerCase,
  plant,
  registerCounter,
  shelfBento,
  shelfSnack,
  wallFridgeDrink
} from "./assets"

type Direction =
  | Down
  | Left
  | Right
  | Up

struct Pose {
  x: Int,
  y: Int,
  direction: Direction,
  frame: Int
}

struct GameState {
  tick: Int,
  selectedCustomer: Int,
  paused: Bool,
  nightMode: Bool,
  lastEvent: String
}

type GameAction =
  | Step Int
  | TogglePause
  | ToggleNightMode
  | SelectCustomer Int

let initialState: GameState = GameState {
  tick: 0,
  selectedCustomer: 7,
  paused: False,
  nightMode: True,
  lastEvent: "深夜営業を開始しました"
}

fn toggle value: Bool -> Bool = if value then False else True

fn wrapTick value: Int -> Int =
  if value >= 24 then wrapTick (value - 24) else value

fn walkFrame value: Int -> Int =
  if value == 0 then 1
  else if value == 1 then 2
  else walkFrame (value - 2)

fn routePose seed: Int -> tick: Int -> Pose =
  let t = wrapTick (tick + seed)
  if t < 4 then
    Pose { x: 15, y: 20 - t, direction: Up, frame: walkFrame t }
  else if t < 8 then
    Pose { x: 15 - (t - 4), y: 16, direction: Left, frame: walkFrame t }
  else if t < 12 then
    Pose { x: 11, y: 16 - (t - 8), direction: Up, frame: walkFrame t }
  else if t < 16 then
    Pose { x: 11 - (t - 12), y: 12, direction: Left, frame: walkFrame t }
  else if t < 20 then
    Pose { x: 7, y: 12 + (t - 16), direction: Down, frame: walkFrame t }
  else
    Pose { x: 7 + (t - 20) * 2, y: 16, direction: Right, frame: walkFrame t }

fn clerkPose -> Pose = Pose { x: 6, y: 17, direction: Down, frame: 0 }
fn clerkFemalePose -> Pose = Pose { x: 8, y: 17, direction: Left, frame: 0 }

fn directionRow direction: Direction -> Int = match direction {
  Down -> 0
  Left -> 1
  Right -> 2
  Up -> 3
}

fn update action: GameAction -> state: GameState -> GameState = match action {
  Step amount ->
    if state.paused then
      GameState { ...state, lastEvent: "一時停止中です" }
    else
      GameState {
        ...state,
        tick: wrapTick (state.tick + amount),
        lastEvent: `店内時間を ${amount} ステップ進めました`
      }
  TogglePause -> GameState {
    ...state,
    paused: toggle state.paused,
    lastEvent: if state.paused then "シミュレーションを再開しました" else "シミュレーションを一時停止しました"
  }
  ToggleNightMode -> GameState {
    ...state,
    nightMode: toggle state.nightMode,
    lastEvent: if state.nightMode then "通常照明へ切り替えました" else "深夜照明へ切り替えました"
  }
  SelectCustomer id -> GameState {
    ...state,
    selectedCustomer: id,
    lastEvent: `顧客 #${id} を選択しました`
  }
}

fn dispatch state: MutableSignal<GameState> -> action: GameAction -> Task<Unit> =
  signals.update (update action) state

fn node style: html.Style
  -> children: Array<html.Html<Task<Unit>>>
  -> html.Html<Task<Unit>> =
  html.div { style, children }

fn text style: html.Style -> value: String -> html.Html<Task<Unit>> =
  html.div { style, children: value }

fn empty style: html.Style -> html.Html<Task<Unit>> =
  html.div { style, children: "" }

fn gridPx value: Int -> String = `${value * 24}px`
fn actorTop value: Int -> String = `${value * 24 - 72}px`

fn fixture path: String
  -> x: Int
  -> y: Int
  -> w: Int
  -> h: Int
  -> z: Int
  -> html.Html<Task<Unit>> =
  empty (html.style {
    position: "absolute",
    left: gridPx x,
    top: gridPx y,
    width: gridPx w,
    height: gridPx h,
    zIndex: `${z}`,
    backgroundImage: `url('${path}')`,
    backgroundSize: "contain",
    backgroundPosition: "center",
    backgroundRepeat: "no-repeat",
    imageRendering: "pixelated",
    filter: "drop-shadow(0 5px 3px rgba(35,28,22,0.24))"
  })

fn actor state: MutableSignal<GameState>
  -> current: GameState
  -> id: Int
  -> path: String
  -> pose: Pose
  -> selectable: Bool
  -> html.Html<Task<Unit>> =
  let selected = selectable && current.selectedCustomer == id
  let row = directionRow pose.direction
  html.button {
    buttonType: "button",
    onClick: if selectable then dispatch state (SelectCustomer id) else dispatch state (Step 0),
    style: html.style {
      position: "absolute",
      left: gridPx pose.x,
      top: actorTop pose.y,
      width: "48px",
      height: "96px",
      zIndex: `${100 + pose.y}`,
      padding: "0",
      border: if selected then "2px solid #4fc3ff" else "2px solid transparent",
      borderRadius: "8px",
      backgroundColor: "transparent",
      backgroundImage: `url('${path}')`,
      backgroundSize: "144px 384px",
      backgroundPosition: `${0 - pose.frame * 48}px ${0 - row * 96}px`,
      backgroundRepeat: "no-repeat",
      imageRendering: "pixelated",
      filter: if selected then "drop-shadow(0 0 7px rgba(79,195,255,0.8))" else "drop-shadow(0 4px 2px rgba(40,30,25,0.28))",
      cursor: if selectable then "pointer" else "default"
    },
    children: ""
  }

fn floor current: GameState -> html.Html<Task<Unit>> =
  node (html.style {
    position: "relative",
    width: "768px",
    height: "568px",
    overflow: "hidden",
    border: "1px solid #23435b",
    borderRadius: "10px",
    backgroundColor: if current.nightMode then "#cbbd9f" else "#e6d8bc",
    backgroundImage: "linear-gradient(rgba(107,88,61,0.11) 1px, transparent 1px), linear-gradient(90deg, rgba(107,88,61,0.11) 1px, transparent 1px)",
    backgroundSize: "24px 24px",
    boxShadow: "0 18px 50px rgba(0,0,0,0.35)"
  }) [
    empty (html.style {
      position: "absolute",
      left: "0",
      top: "0",
      width: "100%",
      height: "46px",
      zIndex: "10",
      background: if current.nightMode then "#172635" else "#d5d0c5",
      borderBottom: "4px solid #345a75"
    }),
    empty (html.style {
      position: "absolute",
      left: "0",
      top: "0",
      width: "24px",
      height: "100%",
      zIndex: "10",
      background: if current.nightMode then "#172635" else "#d5d0c5"
    }),
    empty (html.style {
      position: "absolute",
      right: "0",
      top: "0",
      width: "24px",
      height: "100%",
      zIndex: "10",
      background: if current.nightMode then "#172635" else "#d5d0c5"
    })
  ]

fn storeWorld state: MutableSignal<GameState> -> current: GameState -> html.Html<Task<Unit>> =
  let office = routePose 0 current.tick
  let adult = routePose 8 current.tick
  let student = routePose 16 current.tick
  node (html.style { position: "relative", width: "768px", height: "568px" }) [
    floor current,

    fixture (wallFridgeDrink ()) 17 2 8 4 20,
    fixture (atm ()) 27 3 3 5 24,
    fixture (coffeeMachine ()) 26 9 4 4 24,
    fixture (shelfSnack ()) 10 6 6 2 30,
    fixture (shelfBento ()) 10 11 6 3 31,
    fixture (freezerCase ()) 20 11 6 3 31,
    fixture (registerCounter ()) 3 14 9 4 32,
    fixture (plant ()) 27 15 2 3 30,
    fixture (autoDoor ()) 13 20 6 3 35,

    actor state current 0 (clerkMale ()) (clerkPose ()) False,
    actor state current 0 (clerkFemale ()) (clerkFemalePose ()) False,
    actor state current 7 (shopperMaleOffice ()) office True,
    actor state current 9 (shopperFemaleAdult ()) adult True,
    actor state current 12 (shopperMaleStudent ()) student True
  ]

fn actionButton state: MutableSignal<GameState>
  -> label: String
  -> action: GameAction
  -> active: Bool
  -> html.Html<Task<Unit>> =
  html.button {
    buttonType: "button",
    onClick: dispatch state action,
    style: html.style {
      padding: "10px 14px",
      border: if active then "1px solid #59c6ff" else "1px solid #28506b",
      borderRadius: "7px",
      background: if active then "#10324a" else "#0a1d2b",
      color: "#dcecf8",
      cursor: "pointer",
      fontWeight: "800"
    },
    children: label
  }

fn customerName id: Int -> String = match id {
  7 -> "会社員"
  9 -> "大人女性"
  12 -> "男子学生"
  _ -> "来店客"
}

fn statusPanel current: GameState -> html.Html<Task<Unit>> =
  node (html.style {
    width: "280px",
    boxSizing: "border-box",
    padding: "16px",
    border: "1px solid #23435b",
    borderRadius: "10px",
    background: "linear-gradient(180deg, #0b2132, #071725)",
    color: "#dcecf8"
  }) [
    text (html.style { color: "#66c8ff", fontSize: "12px", fontWeight: "800", letterSpacing: "0.12em" }) "WORLD STATE",
    text (html.style { marginTop: "10px", fontSize: "24px", fontWeight: "900" }) `STEP ${current.tick}`,
    text (html.style { marginTop: "18px", color: "#91a9bb", fontSize: "11px", fontWeight: "800" }) "選択中の顧客",
    text (html.style { marginTop: "4px", fontSize: "19px", fontWeight: "850" }) `#${current.selectedCustomer} ${customerName current.selectedCustomer}`,
    text (html.style { marginTop: "18px", color: "#91a9bb", fontSize: "11px", fontWeight: "800" }) "シミュレーション",
    text (html.style { marginTop: "5px", color: if current.paused then "#ffbd62" else "#68dc83", fontWeight: "850" }) (if current.paused then "PAUSED" else "RUNNING"),
    text (html.style { marginTop: "18px", color: "#91a9bb", fontSize: "11px", fontWeight: "800" }) "イベント",
    text (html.style { marginTop: "5px", lineHeight: "1.6", color: "#d4e5f1", fontSize: "12px" }) current.lastEvent,
    node (html.style { marginTop: "22px", paddingTop: "14px", borderTop: "1px solid #1d3b50" }) [
      text (html.style { color: "#91a9bb", fontSize: "11px", fontWeight: "800" }) "現在のロジック",
      text (html.style { marginTop: "7px", color: "#b8cbd9", fontSize: "11px", lineHeight: "1.7" }) "入口 → 売り場 → 棚前 → レジ側 → 入口 の24step巡回。方向とwalk frameはPoseから自動決定。"
    ]
  ]

fn page state: MutableSignal<GameState> -> current: GameState -> html.Html<Task<Unit>> =
  node (html.style {
    minHeight: "100vh",
    minWidth: "1110px",
    boxSizing: "border-box",
    padding: "14px",
    background: "#06111d",
    color: "#dcecf8",
    fontFamily: "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
  }) [
    node (html.style {
      display: "flex",
      justifyContent: "space-between",
      alignItems: "center",
      marginBottom: "12px",
      padding: "12px 14px",
      border: "1px solid #23435b",
      borderRadius: "10px",
      background: "#081927"
    }) [
      node (html.style {}) [
        text (html.style { color: "#58c6ff", fontSize: "24px", fontWeight: "900" }) "☾ Midnight Konbini",
        text (html.style { marginTop: "3px", color: "#7893a8", fontSize: "11px" }) "grid world / sprite renderer / npc route simulation"
      ],
      node (html.style { display: "flex", gap: "8px" }) [
        actionButton state "▶ 1 step" (Step 1) False,
        actionButton state "▶▶ 4 steps" (Step 4) False,
        actionButton state (if current.paused then "▶ resume" else "Ⅱ pause") TogglePause current.paused,
        actionButton state "☾ night" ToggleNightMode current.nightMode
      ]
    ],
    node (html.style { display: "grid", gridTemplateColumns: "768px 280px", gap: "12px", justifyContent: "center" }) [
      storeWorld state current,
      statusPanel current
    ]
  ]

fn perform action: Task<Unit> -> Task<Unit> = action

effect fn mount content: Signal<html.Html<Task<Unit>>>
  -> Unit
with dom: dom.Dom
fails String =
  do {
    target <- dom.query "#app" |> mapError (\error: dom.DomError -> "DOM target unavailable")
    dom.run (dom.defaultOptions ()) target perform content
      |> mapError (\error: dom.DomRuntimeError<Never> -> "DOM runtime failed")
  }

pub effect fn main = do {
  state <- signals.make initialState
  let content = signals.map (page state) state
  mount content
}

import * as dom from "std/web/dom"
import * as html from "std/web/html"
import * as signals from "std/signal"
import { MutableSignal, Signal } from "std/signal"
import {
  clerkMale,
  shopperMaleOffice,
  shopperFemaleAdult,
  shopperMaleStudent,
  autoDoor,
  freezerCase,
  registerCounter,
  shelfBento,
  shelfSnack,
  wallFridgeDrink
} from "./assets"

type CustomerPhase =
  | Browsing
  | Queueing
  | Leaving

type ShelfId =
  | SnackShelf
  | BentoShelf
  | DrinkShelf

type Target =
  | NoTarget
  | CustomerTarget Int
  | ShelfTarget ShelfId
  | SpillTarget

type Direction =
  | Down
  | Left
  | Right

struct Customer {
  phase: CustomerPhase,
  patience: Int,
  basket: Int
}

struct Pose {
  left: String,
  top: String,
  direction: Direction
}

struct GameState {
  turn: Int,
  money: Int,
  reputation: Int,
  energy: Int,
  served: Int,
  missed: Int,
  theftLoss: Int,
  combo: Int,
  snackStock: Int,
  bentoStock: Int,
  drinkStock: Int,
  spill: Bool,
  studentRisk: Int,
  selected: Target,
  office: Customer,
  adult: Customer,
  student: Customer,
  lastEvent: String
}

type GameAction =
  | Select Target
  | Checkout Int
  | Guide Int
  | WatchStudent
  | Restock ShelfId
  | Clean
  | Break
  | Restart

let initialState = GameState {
  turn: 0,
  money: 0,
  reputation: 92,
  energy: 100,
  served: 0,
  missed: 0,
  theftLoss: 0,
  combo: 0,
  snackStock: 5,
  bentoStock: 4,
  drinkStock: 5,
  spill: False,
  studentRisk: 1,
  selected: CustomerTarget 7,
  office: Customer { phase: Queueing, patience: 78, basket: 720 },
  adult: Customer { phase: Browsing, patience: 100, basket: 460 },
  student: Customer { phase: Browsing, patience: 100, basket: 310 },
  lastEvent: "0:00 — 深夜シフト開始"
}

fn floor0 value: Int -> Int = if value < 0 then 0 else value
fn cap100 value: Int -> Int = if value > 100 then 100 else value
fn lower value: Int -> amount: Int -> Int = floor0 (value - amount)
fn raise value: Int -> amount: Int -> Int = cap100 (value + amount)

fn isQueueing customer: Customer -> Bool = match customer.phase {
  Queueing -> True
  _ -> False
}

fn isBrowsing customer: Customer -> Bool = match customer.phase {
  Browsing -> True
  _ -> False
}

fn willLeave customer: Customer -> Bool = match customer.phase {
  Queueing -> customer.patience <= 20
  _ -> False
}

fn customerById state: GameState -> id: Int -> Customer =
  if id == 7 then state.office
  else if id == 9 then state.adult
  else state.student

fn customerName id: Int -> String =
  if id == 7 then "会社員"
  else if id == 9 then "買い物客"
  else "学生"

fn phaseLabel phase: CustomerPhase -> String = match phase {
  Browsing -> "商品を見ている"
  Queueing -> "レジ待ち"
  Leaving -> "退店中"
}

fn advanceCustomer customer: Customer -> Customer = match customer.phase {
  Browsing -> Customer { ...customer, phase: Queueing, patience: 100 }
  Queueing ->
    if willLeave customer then Customer { ...customer, phase: Leaving, patience: 0 }
    else Customer { ...customer, patience: lower customer.patience 20 }
  Leaving -> Customer { ...customer, phase: Browsing, patience: 100 }
}

fn stockDecay turn: Int -> Bool =
  if turn == 4 then True
  else if turn == 8 then True
  else if turn == 12 then True
  else if turn == 16 then True
  else if turn == 20 then True
  else False

fn spillTurn turn: Int -> Bool =
  if turn == 5 then True
  else if turn == 13 then True
  else if turn == 19 then True
  else False

fn stockPenalty snack: Int -> bento: Int -> drink: Int -> Int =
  (if snack == 0 then 1 else 0)
  + (if bento == 0 then 1 else 0)
  + (if drink == 0 then 1 else 0)

fn advanceOne state: GameState -> GameState = {
  let nextTurn = state.turn + 1
  let officeMiss = if willLeave state.office then 1 else 0
  let adultMiss = if willLeave state.adult then 1 else 0
  let studentMiss = if willLeave state.student then 1 else 0
  let missedNow = officeMiss + adultMiss + studentMiss
  let decay = stockDecay nextTurn
  let nextSnack = if decay then lower state.snackStock 1 else state.snackStock
  let nextBento = if decay then lower state.bentoStock 1 else state.bentoStock
  let nextDrink = if decay then lower state.drinkStock 1 else state.drinkStock
  let nextSpill = if state.spill then True else spillTurn nextTurn
  let nextRisk = if state.studentRisk >= 4 then 0 else state.studentRisk + 1
  let theft = state.studentRisk >= 4
  let repLoss = missedNow * 7 + stockPenalty nextSnack nextBento nextDrink + (if nextSpill then 1 else 0) + (if theft then 4 else 0)
  GameState {
    ...state,
    turn: nextTurn,
    money: if theft then lower state.money 300 else state.money,
    reputation: lower state.reputation repLoss,
    missed: state.missed + missedNow,
    theftLoss: state.theftLoss + (if theft then 300 else 0),
    combo: if missedNow > 0 || theft then 0 else state.combo,
    snackStock: nextSnack,
    bentoStock: nextBento,
    drinkStock: nextDrink,
    spill: nextSpill,
    studentRisk: nextRisk,
    office: advanceCustomer state.office,
    adult: advanceCustomer state.adult,
    student: advanceCustomer state.student
  }
}

fn advanceBy amount: Int -> state: GameState -> GameState =
  if amount <= 0 then state else advanceBy (amount - 1) (advanceOne state)

fn checkout id: Int -> state: GameState -> GameState = {
  let customer = customerById state id
  if isQueueing customer then {
    let paid = customer.basket
    let servedState =
      if id == 7 then GameState {
        ...state,
        money: state.money + paid,
        served: state.served + 1,
        combo: state.combo + 1,
        energy: lower state.energy 2,
        office: Customer { ...state.office, phase: Leaving, patience: 100 }
      }
      else if id == 9 then GameState {
        ...state,
        money: state.money + paid,
        served: state.served + 1,
        combo: state.combo + 1,
        energy: lower state.energy 2,
        adult: Customer { ...state.adult, phase: Leaving, patience: 100 }
      }
      else GameState {
        ...state,
        money: state.money + paid,
        served: state.served + 1,
        combo: state.combo + 1,
        energy: lower state.energy 2,
        studentRisk: 0,
        student: Customer { ...state.student, phase: Leaving, patience: 100 }
      }
    let progressed = advanceOne servedState
    GameState { ...progressed, selected: NoTarget, lastEvent: `${customerName id}を会計 +¥${paid}` }
  }
  else GameState { ...state, lastEvent: `${customerName id}はまだレジに並んでいない` }
}

fn guide id: Int -> state: GameState -> GameState = {
  let customer = customerById state id
  if isBrowsing customer then {
    let guidedState =
      if id == 7 then GameState {
        ...state,
        energy: lower state.energy 1,
        office: Customer { ...state.office, basket: state.office.basket + 160 }
      }
      else if id == 9 then GameState {
        ...state,
        energy: lower state.energy 1,
        adult: Customer { ...state.adult, basket: state.adult.basket + 120 }
      }
      else GameState {
        ...state,
        energy: lower state.energy 1,
        studentRisk: lower state.studentRisk 2,
        student: Customer { ...state.student, basket: state.student.basket + 80 }
      }
    let progressed = advanceOne guidedState
    GameState { ...progressed, lastEvent: `${customerName id}を案内した。ついで買いが増えた` }
  }
  else GameState { ...state, lastEvent: `${customerName id}は今は案内を必要としていない` }
}

fn restock shelf: ShelfId -> state: GameState -> GameState = {
  let base = match shelf {
    SnackShelf -> GameState { ...state, snackStock: 6, energy: lower state.energy 4 }
    BentoShelf -> GameState { ...state, bentoStock: 6, energy: lower state.energy 4 }
    DrinkShelf -> GameState { ...state, drinkStock: 6, energy: lower state.energy 4 }
  }
  let progressed = advanceBy 2 base
  let label = match shelf {
    SnackShelf -> "スナック棚"
    BentoShelf -> "弁当棚"
    DrinkShelf -> "ドリンク棚"
  }
  GameState { ...progressed, selected: NoTarget, lastEvent: `${label}を補充した` }
}

fn clean state: GameState -> GameState =
  if state.spill then {
    let base = GameState { ...state, spill: False, energy: lower state.energy 3, reputation: raise state.reputation 2 }
    let progressed = advanceBy 2 base
    GameState { ...progressed, selected: NoTarget, lastEvent: "床の汚れを片付けた ★+2" }
  }
  else GameState { ...state, lastEvent: "今は清掃が必要な場所はない" }

fn watchStudent state: GameState -> GameState = {
  let base = GameState { ...state, studentRisk: 0, energy: lower state.energy 1 }
  let progressed = advanceOne base
  GameState { ...progressed, lastEvent: "学生に声をかけた。盗難リスク低下" }
}

fn takeBreak state: GameState -> GameState = {
  let base = GameState { ...state, energy: raise state.energy 25, combo: 0 }
  let progressed = advanceBy 2 base
  GameState { ...progressed, selected: NoTarget, lastEvent: "バックヤードで小休憩 ⚡+25" }
}

fn update action: GameAction -> state: GameState -> GameState =
  if state.turn >= 24 then
    match action {
      Restart -> initialState
      _ -> state
    }
  else
    match action {
      Select target -> GameState { ...state, selected: target }
      Checkout id -> checkout id state
      Guide id -> guide id state
      WatchStudent -> watchStudent state
      Restock shelf -> restock shelf state
      Clean -> clean state
      Break -> takeBreak state
      Restart -> initialState
    }

fn dispatch state: MutableSignal<GameState> -> action: GameAction -> Task<Unit> =
  signals.update (update action) state

fn node style: html.Style
  -> children: Array<html.Html<Task<Unit>>>
  -> html.Html<Task<Unit>> =
  html.div { style, children }

fn text style: html.Style -> value: String -> html.Html<Task<Unit>> =
  html.div { style, children: value }

fn actionButton state: MutableSignal<GameState>
  -> label: String
  -> action: GameAction
  -> primary: Bool
  -> html.Html<Task<Unit>> =
  html.button {
    buttonType: "button",
    onClick: dispatch state action,
    style: html.style {
      minHeight: "48px",
      padding: "11px 12px",
      border: if primary then "1px solid #56d2ff" else "1px solid rgba(255,255,255,0.14)",
      borderRadius: "14px",
      background: if primary then "linear-gradient(180deg, #0b7198, #075574)" else "#0b1c29",
      color: "#f0fbff",
      fontSize: "13px",
      fontWeight: "850",
      cursor: "pointer"
    },
    children: label
  }

fn fixture path: String
  -> left: String
  -> top: String
  -> width: String
  -> height: String
  -> html.Html<Task<Unit>> =
  node (html.style {
    position: "absolute",
    left,
    top,
    width,
    height,
    backgroundImage: `url('${path}')`,
    backgroundSize: "contain",
    backgroundPosition: "center",
    backgroundRepeat: "no-repeat",
    imageRendering: "pixelated"
  }) []

fn directionRow direction: Direction -> Int = match direction {
  Down -> 0
  Left -> 1
  Right -> 2
}

fn pose id: Int -> phase: CustomerPhase -> Pose =
  if id == 7 then
    match phase {
      Browsing -> Pose { left: "20%", top: "48%", direction: Down }
      Queueing -> Pose { left: "24%", top: "68%", direction: Left }
      Leaving -> Pose { left: "44%", top: "82%", direction: Right }
    }
  else if id == 9 then
    match phase {
      Browsing -> Pose { left: "58%", top: "39%", direction: Down }
      Queueing -> Pose { left: "30%", top: "67%", direction: Left }
      Leaving -> Pose { left: "47%", top: "82%", direction: Right }
    }
  else
    match phase {
      Browsing -> Pose { left: "72%", top: "52%", direction: Down }
      Queueing -> Pose { left: "36%", top: "68%", direction: Left }
      Leaving -> Pose { left: "51%", top: "82%", direction: Right }
    }

fn actor state: MutableSignal<GameState>
  -> current: GameState
  -> id: Int
  -> path: String
  -> customer: Customer
  -> html.Html<Task<Unit>> = {
  let p = pose id customer.phase
  let row = directionRow p.direction
  let selected = match current.selected {
    CustomerTarget selectedId -> selectedId == id
    _ -> False
  }
  html.button {
    buttonType: "button",
    onClick: dispatch state (Select (CustomerTarget id)),
    style: html.style {
      position: "absolute",
      left: p.left,
      top: p.top,
      width: "48px",
      height: "96px",
      padding: "0",
      border: if selected then "2px solid #56d2ff" else "2px solid transparent",
      borderRadius: "12px",
      backgroundColor: "transparent",
      backgroundImage: `url('${path}')`,
      backgroundSize: "144px 384px",
      backgroundPosition: `0px ${0 - row * 96}px`,
      backgroundRepeat: "no-repeat",
      imageRendering: "pixelated",
      cursor: "pointer"
    },
    children: ""
  }
}

fn shelfButton state: MutableSignal<GameState>
  -> shelf: ShelfId
  -> path: String
  -> left: String
  -> top: String
  -> width: String
  -> height: String
  -> html.Html<Task<Unit>> =
  html.button {
    buttonType: "button",
    onClick: dispatch state (Select (ShelfTarget shelf)),
    style: html.style {
      position: "absolute",
      left,
      top,
      width,
      height,
      padding: "0",
      border: "0",
      backgroundColor: "transparent",
      backgroundImage: `url('${path}')`,
      backgroundSize: "contain",
      backgroundPosition: "center",
      backgroundRepeat: "no-repeat",
      imageRendering: "pixelated",
      cursor: "pointer"
    },
    children: ""
  }

fn world state: MutableSignal<GameState> -> current: GameState -> html.Html<Task<Unit>> =
  node (html.style {
    position: "relative",
    width: "100%",
    height: "420px",
    overflow: "hidden",
    border: "1px solid #24465d",
    borderRadius: "20px",
    backgroundColor: "#d8c8a6",
    backgroundImage: "linear-gradient(rgba(96,78,51,0.10) 1px, transparent 1px), linear-gradient(90deg, rgba(96,78,51,0.10) 1px, transparent 1px)",
    backgroundSize: "24px 24px",
    boxShadow: "0 18px 50px rgba(0,0,0,0.32)"
  }) [
    fixture (wallFridgeDrink ()) "5%" "4%" "31%" "14%",
    fixture (autoDoor ()) "40%" "84%" "20%" "14%",
    fixture (registerCounter ()) "4%" "68%" "38%" "17%",
    shelfButton state SnackShelf (shelfSnack ()) "42%" "22%" "34%" "11%",
    shelfButton state BentoShelf (shelfBento ()) "41%" "44%" "35%" "14%",
    shelfButton state DrinkShelf (freezerCase ()) "61%" "65%" "31%" "14%",
    fixture (clerkMale ()) "11%" "58%" "48px" "96px",
    actor state current 7 (shopperMaleOffice ()) current.office,
    actor state current 9 (shopperFemaleAdult ()) current.adult,
    actor state current 12 (shopperMaleStudent ()) current.student,
    if current.spill then
      html.button {
        buttonType: "button",
        onClick: dispatch state (Select SpillTarget),
        style: html.style {
          position: "absolute",
          left: "55%",
          top: "64%",
          width: "62px",
          height: "34px",
          border: "2px solid #ffb74d",
          borderRadius: "999px",
          background: "rgba(255,183,77,0.28)",
          color: "#6d3f00",
          fontSize: "11px",
          fontWeight: "900",
          cursor: "pointer"
        },
        children: "汚れ!"
      }
    else node (html.style {}) []
  ]

fn stockOf current: GameState -> shelf: ShelfId -> Int = match shelf {
  SnackShelf -> current.snackStock
  BentoShelf -> current.bentoStock
  DrinkShelf -> current.drinkStock
}

fn shelfName shelf: ShelfId -> String = match shelf {
  SnackShelf -> "スナック棚"
  BentoShelf -> "弁当棚"
  DrinkShelf -> "ドリンク棚"
}

fn selectedPanel state: MutableSignal<GameState> -> current: GameState -> html.Html<Task<Unit>> =
  match current.selected {
    NoTarget ->
      node (html.style { display: "grid", gap: "10px" }) [
        text (html.style { fontSize: "13px", color: "#9db4c4" }) "店内の客・棚・トラブルをタップ",
        actionButton state "☕ 2ターン休憩する" Break False
      ]
    CustomerTarget id -> {
      let customer = customerById current id
      node (html.style { display: "grid", gap: "10px" }) [
        node (html.style { display: "flex", justifyContent: "space-between", gap: "12px" }) [
          node (html.style {}) [
            text (html.style { fontSize: "18px", fontWeight: "900" }) (customerName id),
            text (html.style { marginTop: "3px", color: "#8fa9bb", fontSize: "12px" }) (phaseLabel customer.phase)
          ],
          node (html.style { textAlign: "right" }) [
            text (html.style { fontWeight: "900" }) `¥${customer.basket}`,
            text (html.style { color: if customer.patience <= 40 then "#ff8a80" else "#82d98c", fontSize: "12px" }) `忍耐 ${customer.patience}%`
          ]
        ],
        node (html.style { display: "grid", gridTemplateColumns: "1fr 1fr", gap: "8px" }) [
          actionButton state "会計する" (Checkout id) True,
          actionButton state "商品を案内" (Guide id) False
        ],
        if id == 12 then actionButton state `声をかける · リスク${current.studentRisk}/4` WatchStudent False else node (html.style {}) []
      ]
    }
    ShelfTarget shelf ->
      node (html.style { display: "grid", gap: "10px" }) [
        node (html.style { display: "flex", justifyContent: "space-between" }) [
          text (html.style { fontSize: "18px", fontWeight: "900" }) (shelfName shelf),
          text (html.style { color: if stockOf current shelf <= 1 then "#ff8a80" else "#82d98c", fontWeight: "900" }) `在庫 ${stockOf current shelf}/6`
        ],
        actionButton state "2ターン使って補充" (Restock shelf) True
      ]
    SpillTarget ->
      node (html.style { display: "grid", gap: "10px" }) [
        text (html.style { fontSize: "18px", fontWeight: "900" }) "床が汚れている",
        text (html.style { color: "#9db4c4", fontSize: "12px" }) "放置すると毎ターン評判が下がる",
        actionButton state "2ターン使って清掃" Clean True
      ]
  }

fn score current: GameState -> Int =
  current.money + current.served * 180 + current.reputation * 20 - current.missed * 280 - current.theftLoss

fn rank current: GameState -> String = {
  let value = score current
  if value >= 6500 then "S"
  else if value >= 5200 then "A"
  else if value >= 4000 then "B"
  else if value >= 2800 then "C"
  else "D"
}

fn resultPanel state: MutableSignal<GameState> -> current: GameState -> html.Html<Task<Unit>> =
  node (html.style {
    display: "grid",
    gap: "12px",
    padding: "20px",
    border: "1px solid #33576e",
    borderRadius: "18px",
    background: "linear-gradient(180deg, #102b3c, #081823)",
    textAlign: "center"
  }) [
    text (html.style { color: "#73d8ff", fontSize: "12px", fontWeight: "850", letterSpacing: "0.12em" }) "SHIFT COMPLETE",
    text (html.style { fontSize: "64px", lineHeight: "1", fontWeight: "950" }) (rank current),
    text (html.style { fontSize: "22px", fontWeight: "900" }) `${score current} pts`,
    text (html.style { color: "#9db4c4", fontSize: "12px", lineHeight: "1.7" }) `売上 ¥${current.money} · 会計 ${current.served}人 · 帰宅 ${current.missed}人 · 盗難 ¥${current.theftLoss}`,
    actionButton state "もう一度 夜勤する" Restart True
  ]

fn topBar current: GameState -> html.Html<Task<Unit>> =
  node (html.style {
    display: "grid",
    gridTemplateColumns: "1fr auto",
    gap: "10px",
    alignItems: "center"
  }) [
    node (html.style {}) [
      text (html.style { color: "#6bd5ff", fontSize: "18px", fontWeight: "950" }) "☾ MIDNIGHT KONBINI",
      text (html.style { marginTop: "2px", color: "#7894a8", fontSize: "10px", letterSpacing: "0.08em" }) `NIGHT SHIFT · TURN ${current.turn}/24`
    ],
    node (html.style { textAlign: "right" }) [
      text (html.style { fontSize: "18px", fontWeight: "950" }) `¥${current.money}`,
      text (html.style { color: "#9db4c4", fontSize: "11px" }) `★${current.reputation}  ⚡${current.energy}`
    ]
  ]

fn page state: MutableSignal<GameState> -> current: GameState -> html.Html<Task<Unit>> =
  node (html.style {
    minHeight: "100vh",
    boxSizing: "border-box",
    padding: "14px",
    background: "linear-gradient(180deg, #06111b, #02070b)",
    color: "#eef8ff",
    fontFamily: "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
  }) [
    node (html.style {
      width: "100%",
      maxWidth: "430px",
      marginLeft: "auto",
      marginRight: "auto",
      display: "grid",
      gap: "12px"
    }) [
      topBar current,
      text (html.style { padding: "9px 11px", borderRadius: "12px", background: "#0a1a26", color: "#b8cfdd", fontSize: "11px" }) current.lastEvent,
      world state current,
      if current.turn >= 24 then resultPanel state current
      else node (html.style {
        padding: "14px",
        border: "1px solid #24465d",
        borderRadius: "18px",
        background: "rgba(5,17,26,0.96)"
      }) [selectedPanel state current]
    ]
  ]

fn perform action: Task<Unit> -> Task<Unit> = action

effect fn mount content: Signal<html.Html<Task<Unit>>>
  -> Unit
with dom: dom.Dom
fails String =
  do {
    target <- dom.query "#app" |> mapError (\error: dom.DomError -> "DOM target unavailable")
    dom.run (dom.defaultOptions ()) target perform content
      |> mapError (\error: dom.DomRuntimeError<Never> -> "DOM runtime failed")
  }

pub effect fn main = do {
  state <- signals.make initialState
  let content = signals.map (page state) state
  mount content
}

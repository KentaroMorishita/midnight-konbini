fn fixture title: String
  -> left: String
  -> top: String
  -> width: String
  -> height: String
  -> accent: String
  -> html.Html<Task<Unit>> =
  html.div {
    style: fixtureStyle left top width height accent,
    children: [
      html.div {
        style: html.style {
          position: "absolute",
          top: "-20px",
          left: "0",
          right: "0",
          color: "#ffffff",
          textAlign: "center",
          fontSize: "11px",
          fontWeight: "800",
          lineHeight: "18px"
        },
        children: title
      },
      productGrid ()
    ]
  }


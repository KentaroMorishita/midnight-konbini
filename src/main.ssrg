fn customerSprite state: MutableSignal<GameState>
  -> current: GameState
  -> id: Int
  -> left: String
  -> top: String
  -> shirt: String
  -> html.Html<Task<Unit>> =
  html.button {
    style: html.style {
      position: "absolute",
      left,
      top,
      width: "46px",
      height: "62px",
      padding: "2px",
      border: if current.selectedCustomer == id then "2px solid #38bdf8" else "2px solid transparent",
      borderRadius: "12px",
      background: if current.selectedCustomer == id then "rgba(56,189,248,0.12)" else "transparent",
      boxShadow: if current.selectedCustomer == id then "0 0 18px rgba(56,189,248,0.55)" else "none",
      cursor: "pointer"
    },
    onClick: dispatch state (SelectCustomer id),
    children: [customerHead (), customerBody shirt, basketMarker ()]
  }


fn metric label: String -> value: String -> foot: String -> html.Html<Task<Unit>> =
  html.div {
    style: metricStyle,
    children: [
      html.p { style: metricLabelStyle, children: label },
      html.p { style: metricValueStyle, children: value },
      html.p { style: metricFootStyle, children: foot }
    ]
  }

fn topAction state: MutableSignal<GameState> -> label: String -> message: String -> html.Html<Task<Unit>> =
  html.button {
    style: iconButtonStyle,
    onClick: dispatch state (Log message),
    children: label
  }

fn topBar state: MutableSignal<GameState> -> current: GameState -> html.Html<Task<Unit>> =
  html.div {
    style: topGridStyle,
    children: [
      html.div {
        style: titleCardStyle,
        children: [
          html.h1 { style: titleMainStyle, children: "☾ 深夜コンビニ" },
          html.p { style: titleSubStyle, children: "MIDNIGHT KONBINI" }
        ]
      },
      metric "時間" (timeText current) (if current.paused then "PAUSED" else "4月15日 / 夜勤中"),
      metric "売上（本日）" (yen current.sales) "前日比  +12.4%",
      metric "満足度" (percent current.satisfaction) "+3%",
      metric "在庫アラート" `${current.stockAlerts}` (if current.stockAlerts == 0 then "補充済み" else "要対応"),
      metric "清潔度" (percent current.cleanliness) (if current.cleanliness >= 85 then "良好" else "やや汚れている"),
      metric "エネルギー" (percent current.energy) "残り 4.2時間",
      html.div {
        style: topActionsStyle,
        children: [
          topAction state "▥" "売上レポートを確認しました",
          topAction state "✉" "メッセージを確認しました",
          topAction state "⚙" "設定を確認しました",
          topAction state "☰" "メニューを開きました"
        ]
      }
    ]
  }

fn menuButton state: MutableSignal<GameState>
  -> icon: String
  -> label: String
  -> hotkey: String
  -> action: GameAction
  -> html.Html<Task<Unit>> =
  html.button {
    style: menuButtonStyle,
    onClick: dispatch state action,
    children: [
      html.span { children: `${icon}  ${label}` },
      html.span { style: hotkeyStyle, children: hotkey }
    ]
  }


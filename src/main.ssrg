fn patience current: GameState -> html.Html<Task<Unit>> =
  node (html.style { marginTop: "12px", paddingTop: "10px", borderTop: "1px solid #183a55" }) [
    node (html.style { display: "flex", justifyContent: "space-between", marginBottom: "6px", fontSize: "11px", fontWeight: "700" }) [
      text (html.style {}) "待ち時間（忍耐力）",
      text (html.style {}) "01:32"
    ],
    node (html.style { height: "8px", borderRadius: "999px", background: "#173149", overflow: "hidden" }) [
      progress (customerPatience current.selectedCustomer)
    ]
  ]

fn basketLine icon: String -> name: String -> price: Int -> html.Html<Task<Unit>> =
  node (html.style {
    display: "grid",
    gridTemplateColumns: "22px 1fr auto",
    gap: "6px",
    padding: "5px 0",
    color: "#d3e2ef",
    fontSize: "12px"
  }) [
    text (html.style {}) icon,
    text (html.style {}) name,
    text (html.style {}) (yen price)
  ]

fn basket current: GameState -> html.Html<Task<Unit>> =
  node (html.style { marginTop: "13px" }) [
    text (html.style { color: "#d7e7f3", fontSize: "12px", fontWeight: "800" }) "カゴの中身",
    basketLine "◒" "おにぎり 鮭" 130,
    basketLine "▣" "からあげ弁当" 498,
    basketLine "▮" "緑茶 600ml" 120,
    node (html.style { display: "flex", justifyContent: "space-between", paddingTop: "8px", borderTop: "1px solid #24445c", fontWeight: "900" }) [
      text (html.style {}) "合計",
      text (html.style {}) (yen (customerTotal current.selectedCustomer))
    ]
  ]

fn quickStyle color: String -> html.Style = html.style {
  padding: "9px 8px",
  border: `1px solid ${color}`,
  borderRadius: "6px",
  background: "rgba(8,26,41,0.82)",
  color: color,
  cursor: "pointer",
  fontSize: "11px",
  fontWeight: "800"
}

fn flagAction state: MutableSignal<GameState> -> current: GameState -> html.Html<Task<Unit>> =
  actionButton state
    (html.style {
      gridColumn: "1 / -1",
      padding: "9px 8px",
      border: if current.flagged then "1px solid #ffb14a" else "1px solid #e55e59",
      borderRadius: "6px",
      background: "rgba(8,26,41,0.82)",
      color: if current.flagged then "#ffb14a" else "#e55e59",
      cursor: "pointer",
      fontSize: "11px",
      fontWeight: "800"
    })
    (if current.flagged then "⚑ 要注意として登録済み" else "⚑ 不審としてマーク")
    MarkSuspicious

fn customerActions state: MutableSignal<GameState> -> current: GameState -> html.Html<Task<Unit>> =
  node (html.style { marginTop: "12px" }) [
    text (html.style { marginBottom: "7px", fontSize: "12px", fontWeight: "800" }) "クイックアクション",
    node (html.style { display: "grid", gridTemplateColumns: "1fr 1fr", gap: "6px" }) [
      actionButton state (quickStyle "#67d47d") "☆ 会計を優先" PrioritizeCheckout,
      actionButton state
        (quickStyle (if current.recommended then "#70e2cf" else "#b284f3"))
        (if current.recommended then "✓ 提案済み" else "♡ 商品をおすすめ")
        RecommendProduct,
      flagAction state current
    ]
  ]

fn customerPanel state: MutableSignal<GameState> -> current: GameState -> html.Html<Task<Unit>> =
  node panelStyle [
    text panelHeaderStyle "選択中の顧客",
    node (html.style { padding: "11px" }) [
      identityRow current,
      patience current,
      basket current,
      customerActions state current
    ]
  ]

fn taskRow icon: String -> label: String -> time: String -> color: String -> html.Html<Task<Unit>> =
  node (html.style {
    display: "grid",
    gridTemplateColumns: "20px 1fr auto",
    gap: "7px",
    padding: "6px 0",
    color: "#d5e4ef",
    fontSize: "11px"
  }) [
    text (html.style { color: color }) icon,
    text (html.style {}) label,
    text (html.style { color: "#8aa3b9" }) time
  ]

fn taskQueue current: GameState -> html.Html<Task<Unit>> =
  node panelGapStyle [
    text panelHeaderStyle "タスク・キュー",
    node (html.style { padding: "8px 12px 10px" }) [
      taskRow "●" `レジに並ぶ（${current.queue}人）` "01:32" "#a98cff",
      taskRow "▦" "品出し：カップ麺 売り場" "02:15" "#ffb347",
      taskRow "♧" "清掃：トイレ" "03:40" "#49c8ff",
      taskRow "♙" "ゴミ回収" "04:05" "#68d36d"
    ]
  ]

fn rightSidebar state: MutableSignal<GameState> -> current: GameState -> html.Html<Task<Unit>> =
  node (html.style {}) [customerPanel state current, taskQueue current]

fn eventLine time: String -> icon: String -> label: String -> color: String -> html.Html<Task<Unit>> =
  node (html.style {
    display: "grid",
    gridTemplateColumns: "42px 18px 1fr",
    gap: "5px",
    padding: "3px 0",
    color: color,
    fontSize: "10px"
  }) [
    text (html.style { color: "#8097ab" }) time,
    text (html.style {}) icon,
    text (html.style {}) label
  ]

fn eventLog current: GameState -> html.Html<Task<Unit>> =
  node panelStyle [
    text panelHeaderStyle "イベントログ",
    node (html.style { padding: "8px 12px" }) [
      eventLine "NOW" "•" current.lastEvent "#dbe9f4",
      eventLine "23:38" "▲" "カップ麺コーナーの在庫が少なくなっています" "#f0b74b",
      eventLine "23:31" "◆" "不審な人物を警備員が注意しました" "#d9e4ec",
      eventLine "23:20" "▥" "深夜の混雑時間帯に入ります（+15% 来客）" "#8fcaff",
      eventLine "23:12" "♨" "冷凍庫の温度が上昇しています（+1.2℃）" "#f06860"
    ]
  ]

fn controlStyle active: Bool -> html.Style = html.style {
  minHeight: "96px",
  border: if active then "1px solid #5abcf7" else "1px solid #214761",
  borderRadius: "8px",
  background: if active then "linear-gradient(180deg, #0d3955, #0a2336)" else "linear-gradient(180deg, #0b2235, #081a2a)",
  color: "#dbeaf7",
  cursor: "pointer",
  fontSize: "12px",
  fontWeight: "800"
}

fn quickControls state: MutableSignal<GameState> -> current: GameState -> html.Html<Task<Unit>> =
  node panelStyle [
    text panelHeaderStyle "クイックコントロール",
    node (html.style { display: "grid", gridTemplateColumns: "repeat(5, 1fr)", gap: "7px", padding: "10px" }) [
      actionButton state (controlStyle False) "▶  1分進める" (Advance 1),
      actionButton state (controlStyle False) "◴  5分進める" (Advance 5),
      actionButton state (controlStyle current.paused) (if current.paused then "▶  再開" else "Ⅱ  一時停止") TogglePause,
      actionButton state (controlStyle False) "☾+  1時間進める" (Advance 60),
      actionButton state (controlStyle current.nightMode) "◉  深夜モード" ToggleNightMode
    ]
  ]

fn summaryRow label: String -> value: String -> html.Html<Task<Unit>> =
  node (html.style { display: "flex", justifyContent: "space-between", gap: "12px" }) [
    text (html.style {}) label,
    text (html.style { color: "#d9e7f2" }) value
  ]

fn dailySummary current: GameState -> html.Html<Task<Unit>> =
  node panelStyle [
    text panelHeaderStyle "本日のまとめ（4/15）",
    node (html.style { display: "grid", gap: "8px", padding: "11px 13px", color: "#9fb4c5", fontSize: "11px" }) [
      summaryRow "来客数" "432人",
      summaryRow "平均客単価" "¥827",
      summaryRow "廃棄ロス" "¥4,210",
      summaryRow "電気代（予測）" "¥8,760",
      summaryRow "現在満足度" (percent current.satisfaction)
    ]
  ]

fn page state: MutableSignal<GameState> -> current: GameState -> html.Html<Task<Unit>> =
  node appStyle [
    topBar state current,
    node bodyGridStyle [leftSidebar state, storePanel state current, rightSidebar state current],
    node bottomGridStyle [eventLog current, quickControls state current, dailySummary current]
  ]

fn perform action: Task<Unit> -> Task<Unit> = action

effect fn mount content: Signal<html.Html<Task<Unit>>>
  -> Unit
with dom: dom.Dom
fails String =
  do {
    target <-
      dom.query "#app"
        |> mapError (\error: dom.DomError -> "DOM target unavailable")
    dom.run (dom.defaultOptions ()) target perform content
      |> mapError (\error: dom.DomRuntimeError<Never> -> "DOM runtime failed")
  }

pub effect fn main = do {
  state <- signals.make initialState
  let content = signals.map (page state) state
  mount content
}

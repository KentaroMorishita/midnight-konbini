fn titleCard -> html.Html<Task<Unit>> =
  node titleCardStyle [
    text titleMainStyle "☾ 深夜コンビニ",
    text titleSubStyle "MIDNIGHT KONBINI"
  ]

fn metric label: String -> value: String -> foot: String -> html.Html<Task<Unit>> =
  node metricStyle [
    text metricLabelStyle label,
    text metricValueStyle value,
    text metricFootStyle foot
  ]

fn topActions state: MutableSignal<GameState> -> html.Html<Task<Unit>> =
  node topActionsStyle [
    actionButton state iconButtonStyle "▥" (Log "売上レポートを確認しました"),
    actionButton state iconButtonStyle "✉" (Log "メッセージを確認しました"),
    actionButton state iconButtonStyle "⚙" (Log "設定を確認しました"),
    actionButton state iconButtonStyle "☰" (Log "メニューを開きました")
  ]

fn topBar state: MutableSignal<GameState> -> current: GameState -> html.Html<Task<Unit>> =
  node topGridStyle [
    titleCard (),
    metric "時間" (timeText current) (if current.paused then "PAUSED" else "4月15日 / 夜勤中"),
    metric "売上（本日）" (yen current.sales) "前日比  +12.4%",
    metric "満足度" (percent current.satisfaction) "+3%",
    metric "在庫アラート" `${current.stockAlerts}` (if current.stockAlerts == 0 then "補充済み" else "要対応"),
    metric "清潔度" (percent current.cleanliness) (if current.cleanliness >= 85 then "良好" else "やや汚れている"),
    metric "エネルギー" (percent current.energy) "残り 4.2時間",
    topActions state
  ]


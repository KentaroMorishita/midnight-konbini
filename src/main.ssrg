import * as dom from "std/web/dom"
import * as html from "std/web/html"
import * as signals from "std/signal"
import { MutableSignal, Signal } from "std/signal"

struct GameState {
  hour: Int,
  minute: Int,
  sales: Int,
  satisfaction: Int,
  stockAlerts: Int,
  cleanliness: Int,
  energy: Int,
  selectedCustomer: Int,
  queue: Int,
  paused: Bool,
  nightMode: Bool,
  flagged: Bool,
  recommended: Bool,
  lastEvent: String
}

type GameAction =
  | Advance Int
  | TogglePause
  | ToggleNightMode
  | SelectCustomer Int
  | Restock
  | Clean
  | PrioritizeCheckout
  | RecommendProduct
  | MarkSuspicious
  | Log String

let initialState: GameState = GameState {
  hour: 23,
  minute: 47,
  sales: 398670,
  satisfaction: 86,
  stockAlerts: 7,
  cleanliness: 78,
  energy: 62,
  selectedCustomer: 12,
  queue: 2,
  paused: False,
  nightMode: True,
  flagged: False,
  recommended: False,
  lastEvent: "配送が到着しました（冷凍食品）"
}

fn toggle value: Bool -> Bool = if value then False else True
fn cap100 value: Int -> Int = if value > 100 then 100 else value
fn floor0 value: Int -> Int = if value < 0 then 0 else value
fn nextHour value: Int -> Int = if value >= 23 then 0 else value + 1

fn advanceTime amount: Int -> state: GameState -> GameState =
  if state.minute + amount >= 60 then
    GameState {
      ...state,
      hour: nextHour state.hour,
      minute: state.minute + amount - 60,
      sales: state.sales + amount * 31,
      cleanliness: floor0 (state.cleanliness - 1),
      energy: floor0 (state.energy - 1),
      lastEvent: "時間を進めました。店内状況が更新されています"
    }
  else
    GameState {
      ...state,
      minute: state.minute + amount,
      sales: state.sales + amount * 31,
      lastEvent: "時間を進めました。店内状況が更新されています"
    }

fn update action: GameAction -> state: GameState -> GameState =
  match action {
    Advance amount -> advanceTime amount state
    TogglePause -> GameState {
      ...state,
      paused: toggle state.paused,
      lastEvent: if state.paused then "営業シミュレーションを再開しました" else "営業シミュレーションを一時停止しました"
    }
    ToggleNightMode -> GameState {
      ...state,
      nightMode: toggle state.nightMode,
      lastEvent: if state.nightMode then "通常表示へ切り替えました" else "深夜モードへ切り替えました"
    }
    SelectCustomer id -> GameState {
      ...state,
      selectedCustomer: id,
      flagged: False,
      recommended: False,
      lastEvent: `顧客 #${id} を選択しました`
    }
    Restock -> GameState {
      ...state,
      stockAlerts: 0,
      energy: floor0 (state.energy - 3),
      lastEvent: "不足商品の補充を完了しました"
    }
    Clean -> GameState {
      ...state,
      cleanliness: cap100 (state.cleanliness + 15),
      energy: floor0 (state.energy - 2),
      satisfaction: cap100 (state.satisfaction + 1),
      lastEvent: "店内清掃を実行しました"
    }
    PrioritizeCheckout -> GameState {
      ...state,
      queue: floor0 (state.queue - 1),
      sales: state.sales + 748,
      satisfaction: cap100 (state.satisfaction + 2),
      lastEvent: "選択中の顧客を優先会計しました"
    }
    RecommendProduct -> GameState {
      ...state,
      recommended: True,
      sales: state.sales + 160,
      satisfaction: cap100 (state.satisfaction + 1),
      lastEvent: "おすすめ商品を提案しました"
    }
    MarkSuspicious -> GameState {
      ...state,
      flagged: True,
      lastEvent: "選択中の顧客を要注意としてマークしました"
    }
    Log message -> GameState { ...state, lastEvent: message }
  }

fn dispatch state: MutableSignal<GameState> -> action: GameAction -> Task<Unit> =
  signals.update (update action) state

fn timeText current: GameState -> String = `${current.hour}:${current.minute}`
fn yen amount: Int -> String = `¥${amount}`
fn percent amount: Int -> String = `${amount}%`

fn node style: html.Style
  -> children: Array<html.Html<Task<Unit>>>
  -> html.Html<Task<Unit>> =
  html.div { style, children }

fn text style: html.Style -> value: String -> html.Html<Task<Unit>> =
  html.div { style, children: value }

fn empty style: html.Style -> html.Html<Task<Unit>> = text style ""

fn actionButton state: MutableSignal<GameState>
  -> style: html.Style
  -> label: String
  -> action: GameAction
  -> html.Html<Task<Unit>> =
  html.button {
    style,
    onClick: dispatch state action,
    children: label
  }


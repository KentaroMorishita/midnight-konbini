  -> width: String
  -> height: String
  -> accent: String
  -> html.Html<Task<Unit>> =
  node (fixtureStyle left top width height accent) [
    text (html.style {
      position: "absolute",
      top: "-20px",
      left: "0",
      right: "0",
      color: "#ffffff",
      textAlign: "center",
      fontSize: "11px",
      fontWeight: "800",
      lineHeight: "18px"
    }) title,
    productGrid ()
  ]


  node storePanelStyle [storeFloor state current]

fn customerName id: Int -> String = match id {
  12 -> "大学生"
  7 -> "会社員"
  4 -> "会社員"
  9 -> "専門学生"
  15 -> "常連客"
  _ -> "来店客"
}

fn customerVisits id: Int -> Int = match id {
  12 -> 7
  7 -> 3
  4 -> 11
  9 -> 2
  15 -> 24
  _ -> 1
}

fn customerSpend id: Int -> Int = match id {
  12 -> 18540
  7 -> 6920
  4 -> 31740
  9 -> 3580
  15 -> 65420
  _ -> 980
}

fn customerPatience id: Int -> Int = match id {
  12 -> 78
  7 -> 51
  4 -> 91
  9 -> 63
  15 -> 84
  _ -> 70
}

fn customerTotal id: Int -> Int = match id {
  12 -> 748
  7 -> 612
  4 -> 1098
  9 -> 498
  15 -> 1382
  _ -> 320
}


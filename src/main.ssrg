    ]
  }

fn basketLine icon: String -> name: String -> price: Int -> html.Html<Task<Unit>> =
  html.div {
    style: html.style {
      display: "grid",
      gridTemplateColumns: "22px 1fr auto",
      gap: "6px",
      padding: "5px 0",
      color: "#d3e2ef",
      fontSize: "12px"
    },
    children: [
      html.span { children: icon },
      html.span { children: name },
      html.span { children: yen price }
    ]
  }

fn progress value: Int -> html.Html<Task<Unit>> =
  html.div {
    style: html.style {
      width: `${value}%`,
      height: "100%",
      borderRadius: "999px",
      background: "linear-gradient(90deg, #59db63, #91dc35)",
      boxShadow: "0 0 10px rgba(99,220,75,0.25)"
    }
  }

fn quickButton state: MutableSignal<GameState>
  -> label: String
  -> color: String
  -> action: GameAction
  -> html.Html<Task<Unit>> =
  html.button {
    style: html.style {
      padding: "9px 8px",
      border: `1px solid ${color}`,
      borderRadius: "6px",
      background: "rgba(8,26,41,0.82)",
      color,
      cursor: "pointer",
      fontSize: "11px",
      fontWeight: "800"
    },
    onClick: dispatch state action,
    children: label
  }

fn flagButton state: MutableSignal<GameState> -> current: GameState -> html.Html<Task<Unit>> =
  html.button {
    style: html.style {
      gridColumn: "1 / -1",
      padding: "9px 8px",
      border: if current.flagged then "1px solid #ffb14a" else "1px solid #e55e59",
      borderRadius: "6px",
      background: "rgba(8,26,41,0.82)",
      color: if current.flagged then "#ffb14a" else "#e55e59",
      cursor: "pointer",
      fontSize: "11px",
      fontWeight: "800"
    },
    onClick: dispatch state MarkSuspicious,
    children: if current.flagged then "⚑ 要注意として登録済み" else "⚑ 不審としてマーク"
  }

fn taskRow icon: String -> text: String -> time: String -> color: String -> html.Html<Task<Unit>> =
  html.div {
    style: html.style {
      display: "grid",
      gridTemplateColumns: "20px 1fr auto",
      gap: "7px",
      padding: "6px 0",
      alignItems: "center",
      color: "#d5e4ef",
      fontSize: "11px"
    },
    children: [
      html.span { style: html.style { color }, children: icon },
      html.span { children: text },
      html.span { style: tinyLabelStyle, children: time }
    ]
  }

fn taskQueue current: GameState -> html.Html<Task<Unit>> =
  html.section {
    style: panelGapStyle,
    children: [
      html.div { style: panelHeaderStyle, children: "タスク・キュー" },
      html.div {
        style: html.style { padding: "8px 12px 10px" },
        children: [
          taskRow "●" `レジに並ぶ（${current.queue}人）` "01:32" "#a98cff",
          taskRow "▦" "品出し：カップ麺 売り場" "02:15" "#ffb347",
          taskRow "♧" "清掃：トイレ" "03:40" "#49c8ff",
          taskRow "♙" "ゴミ回収" "04:05" "#68d36d"
        ]
      }
    ]
  }

fn rightSidebar state: MutableSignal<GameState> -> current: GameState -> html.Html<Task<Unit>> =
  html.div {
    children: [
      html.section {
        style: panelStyle,
        children: [
          html.div { style: panelHeaderStyle, children: "選択中の顧客" },
          html.div {
            style: html.style { padding: "11px" },
            children: [
              html.div {
                style: html.style { display: "grid", gridTemplateColumns: "76px 1fr", gap: "10px", alignItems: "center" },
                children: [
                  avatar (),
                  html.div {
                    children: [
                      html.div {
                        style: html.style { color: "#f3f8fc", fontSize: "19px", fontWeight: "850" },
                        children: `顧客 #${current.selectedCustomer}`
                      },
                      html.div {
                        style: html.style {
                          display: "inline-block",
                          marginTop: "5px",
                          padding: "3px 8px",
                          borderRadius: "5px",
                          background: "#0b3960",
                          color: "#64bbff",
                          fontSize: "10px",
                          fontWeight: "800"
                        },
                        children: customerName current.selectedCustomer
                      },
                      html.p {
                        style: html.style { margin: "6px 0 0", color: "#8aa3b9", fontSize: "11px" },
                        children: `来店数: ${customerVisits current.selectedCustomer}回`
                      },
                      html.p {
                        style: html.style { margin: "2px 0 0", color: "#8aa3b9", fontSize: "11px" },
                        children: `累計購入額: ¥${customerSpend current.selectedCustomer}`
                      }
                    ]
                  }
                ]
              },
              html.div {
                style: html.style { marginTop: "12px", paddingTop: "10px", borderTop: "1px solid #183a55" },
                children: [
                  html.div {
                    style: html.style { display: "flex", justifyContent: "space-between", marginBottom: "6px", fontSize: "11px", fontWeight: "700" },
                    children: [
                      html.span { children: "待ち時間（忍耐力）" },
                      html.span { children: "01:32" }
                    ]
                  },
                  html.div {
                    style: html.style { height: "8px", borderRadius: "999px", background: "#173149", overflow: "hidden" },
                    children: progress (customerPatience current.selectedCustomer)
                  }
                ]
              },
              html.div {
                style: html.style { marginTop: "13px", color: "#d7e7f3", fontSize: "12px", fontWeight: "800" },
                children: "カゴの中身"
              },
              basketLine "◒" "おにぎり 鮭" 130,
              basketLine "▣" "からあげ弁当" 498,
              basketLine "▮" "緑茶 600ml" 120,
              html.div {
                style: html.style {
                  display: "flex",
                  justifyContent: "space-between",
                  marginTop: "4px",
                  paddingTop: "8px",
                  borderTop: "1px solid #24445c",
                  fontWeight: "900"
                },
                children: [
                  html.span { children: "合計" },
                  html.span { children: yen (customerTotal current.selectedCustomer) }
                ]
              },
              html.div {
                style: html.style { marginTop: "12px", marginBottom: "7px", fontSize: "12px", fontWeight: "800" },
                children: "クイックアクション"
              },
              html.div {
                style: html.style { display: "grid", gridTemplateColumns: "1fr 1fr", gap: "6px" },
                children: [
                  quickButton state "☆ 会計を優先" "#67d47d" PrioritizeCheckout,
                  quickButton state (if current.recommended then "✓ 提案済み" else "♡ 商品をおすすめ") (if current.recommended then "#70e2cf" else "#b284f3") RecommendProduct,
                  flagButton state current
                ]
              }
            ]
          }
        ]
      },
      taskQueue current
    ]
  }

fn eventLine time: String -> icon: String -> text: String -> color: String -> html.Html<Task<Unit>> =
  html.div {
    style: html.style {
      display: "grid",
      gridTemplateColumns: "42px 18px 1fr",
      gap: "5px",
      padding: "3px 0",
      color,
      fontSize: "10px"
    },
    children: [
      html.span { style: html.style { color: "#8097ab" }, children: time },
      html.span { children: icon },
      html.span { children: text }
    ]
  }

fn eventLog current: GameState -> html.Html<Task<Unit>> =
  html.section {
    style: panelStyle,
    children: [
      html.div { style: panelHeaderStyle, children: "イベントログ" },
      html.div {
        style: html.style { padding: "8px 12px" },
        children: [
          eventLine "NOW" "•" current.lastEvent "#dbe9f4",
          eventLine "23:38" "▲" "カップ麺コーナーの在庫が少なくなっています" "#f0b74b",
          eventLine "23:31" "◆" "不審な人物を警備員が注意しました" "#d9e4ec",
          eventLine "23:20" "▥" "深夜の混雑時間帯に入ります（+15% 来客）" "#8fcaff",
          eventLine "23:12" "♨" "冷凍庫の温度が上昇しています（+1.2℃）" "#f06860"
        ]
      }
    ]
  }

fn controlButton state: MutableSignal<GameState>
  -> icon: String
  -> label: String
  -> action: GameAction
  -> active: Bool
  -> html.Html<Task<Unit>> =
  html.button {
    onClick: dispatch state action,
    style: html.style {
      minHeight: "96px",
      border: if active then "1px solid #5abcf7" else "1px solid #214761",
      borderRadius: "8px",
      background: if active then "linear-gradient(180deg, #0d3955, #0a2336)" else "linear-gradient(180deg, #0b2235, #081a2a)",
      color: "#dbeaf7",
      cursor: "pointer"
    },
    children: [
      html.div {
        style: html.style {
          marginBottom: "9px",
          color: if active then "#66c7ff" else "#b9d0e2",
          fontSize: "30px",
          lineHeight: "1"
        },
        children: icon
      },
      html.div { style: html.style { fontSize: "11px", fontWeight: "800" }, children: label }
    ]
  }

fn quickControls state: MutableSignal<GameState> -> current: GameState -> html.Html<Task<Unit>> =
  html.section {
    style: panelStyle,
    children: [
      html.div { style: panelHeaderStyle, children: "クイックコントロール" },
      html.div {
        style: html.style { display: "grid", gridTemplateColumns: "repeat(5, 1fr)", gap: "7px", padding: "10px" },
        children: [
          controlButton state "▶" "1分進める" (Advance 1) False,
          controlButton state "◴" "5分進める" (Advance 5) False,
          controlButton state (if current.paused then "▶" else "Ⅱ") (if current.paused then "再開" else "一時停止") TogglePause current.paused,
          controlButton state "☾+" "1時間進める" (Advance 60) False,
          controlButton state "◉" "深夜モード" ToggleNightMode current.nightMode
        ]
      }
    ]
  }

fn summaryRow label: String -> value: String -> html.Html<Task<Unit>> =
  html.div {
    style: html.style { display: "flex", justifyContent: "space-between", gap: "12px" },
    children: [
      html.span { children: label },
      html.span { style: html.style { color: "#d9e7f2" }, children: value }
    ]
  }

fn dailySummary current: GameState -> html.Html<Task<Unit>> =
  html.section {
    style: panelStyle,
    children: [
      html.div { style: panelHeaderStyle, children: "本日のまとめ（4/15）" },
      html.div {
        style: html.style { display: "grid", gap: "8px", padding: "11px 13px", color: "#9fb4c5", fontSize: "11px" },
        children: [
          summaryRow "来客数" "432人",
          summaryRow "平均客単価" "¥827",
          summaryRow "廃棄ロス" "¥4,210",
          summaryRow "電気代（予測）" "¥8,760",
          summaryRow "現在満足度" (percent current.satisfaction)
        ]
      }
    ]
  }

fn page state: MutableSignal<GameState> -> current: GameState -> html.Html<Task<Unit>> =
  html.main {
    style: appStyle,
    children: [
      topBar state current,
      html.div {
        style: bodyGridStyle,
        children: [
          leftSidebar state,
          storePanel state current,
          rightSidebar state current
        ]
      },
      html.div {
        style: bottomGridStyle,
        children: [
          eventLog current,
          quickControls state current,
          dailySummary current
        ]
      }
    ]
  }

fn perform action: Task<Unit> -> Task<Unit> = action

effect fn mount content: Signal<html.Html<Task<Unit>>>
  -> Unit
with dom: dom.Dom
fails String =
  do {
    target <-
      dom.query "#app"
        |> mapError (\error: dom.DomError -> "DOM target unavailable")
    dom.run (dom.defaultOptions ()) target perform content
      |> mapError (\error: dom.DomRuntimeError<Never> -> "DOM runtime failed")
  }

pub effect fn main = do {
  state <- signals.make initialState
  let content = signals.map (page state) state
  mount content
}

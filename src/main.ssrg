fn customerSpriteStyle left: String -> top: String -> selected: Bool -> html.Style =
  html.style {
    position: "absolute",
    left,
    top,
    width: "46px",
    height: "62px",
    padding: "2px",
    border: if selected then "2px solid #38bdf8" else "2px solid transparent",
    borderRadius: "12px",
    background: if selected then "rgba(56,189,248,0.12)" else "transparent",
    boxShadow: if selected then "0 0 18px rgba(56,189,248,0.55)" else "none",
    cursor: "pointer"
  }

fn customerSprite state: MutableSignal<GameState>
  -> current: GameState
  -> id: Int
  -> left: String
  -> top: String
  -> shirt: String
  -> html.Html<Task<Unit>> =
  html.button {
    style: customerSpriteStyle left top (current.selectedCustomer == id),
    onClick: dispatch state (SelectCustomer id),
    children: [
      html.div { style: customerHeadStyle () },
      html.div { style: customerBodyStyle shirt },
      html.div {
        style: html.style {
          position: "absolute",
          right: "-5px",
          bottom: "4px",
          width: "14px",
          height: "12px",
          border: "2px solid #25323a",
          borderRadius: "2px",
          background: "#243f58"
        }
      }
    ]
  }


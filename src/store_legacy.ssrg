import * as html from "std/web/html"

let atlasImage = "url(data:image/png;base64,)"

fn empty style: html.Style -> html.Html<Task<Unit>> =
  html.div { style, children: "" }

fn sprite left: String
  -> top: String
  -> width: String
  -> height: String
  -> offsetX: Int
  -> offsetY: Int
  -> html.Html<Task<Unit>> =
  empty (html.style {
    position: "absolute",
    left,
    top,
    width,
    height,
    backgroundImage: atlasImage,
    backgroundSize: "960px 320px",
    backgroundPosition: `-${offsetX}px -${offsetY}px`,
    backgroundRepeat: "no-repeat",
    imageRendering: "pixelated",
    filter: "drop-shadow(0 5px 3px rgba(55,38,24,0.18))"
  })

fn wallLabel left: String
  -> top: String
  -> value: String
  -> html.Html<Task<Unit>> =
  html.div {
    style: html.style {
      position: "absolute",
      left,
      top,
      padding: "4px 8px",
      border: "2px solid #173c58",
      background: "#0b3458",
      color: "#f4f0de",
      fontSize: "10px",
      fontWeight: "900",
      letterSpacing: "0.04em",
      boxShadow: "2px 2px 0 #09253d"
    },
    children: value
  }

fn customerArt offsetX: Int -> html.Html<Task<Unit>> =
  empty (html.style {
    position: "absolute",
    left: "7px",
    top: "8px",
    width: "32px",
    height: "48px",
    backgroundImage: atlasImage,
    backgroundSize: "960px 320px",
    backgroundPosition: `-${offsetX}px -248px`,
    backgroundRepeat: "no-repeat",
    imageRendering: "pixelated",
    filter: "drop-shadow(0 4px 2px rgba(50,35,24,0.22))"
  })

fn customer selected: Int
  -> id: Int
  -> left: String
  -> top: String
  -> offsetX: Int
  -> action: Task<Unit>
  -> html.Html<Task<Unit>> =
  html.button {
    buttonType: "button",
    style: html.style {
      position: "absolute",
      left,
      top,
      width: "47px",
      height: "64px",
      padding: "0",
      border: if selected == id then "2px solid #38bdf8" else "2px solid transparent",
      borderRadius: "9px",
      background: if selected == id then "rgba(56,189,248,0.15)" else "transparent",
      boxShadow: if selected == id then "0 0 0 2px rgba(255,255,255,0.7), 0 0 18px #38bdf8" else "none",
      cursor: "pointer"
    },
    onClick: action,
    children: customerArt offsetX
  }

fn clerk -> html.Html<Task<Unit>> =
  html.div {
    style: html.style {
      position: "absolute",
      left: "122px",
      top: "250px",
      width: "47px",
      height: "64px"
    },
    children: customerArt 0
  }

fn floorGlow -> html.Html<Task<Unit>> =
  empty (html.style {
    position: "absolute",
    left: "0",
    top: "0",
    right: "0",
    bottom: "0",
    pointerEvents: "none",
    background: "radial-gradient(circle at 48% 44%, rgba(255,244,207,0.16), transparent 46%), linear-gradient(180deg, rgba(255,248,222,0.07), rgba(91,64,37,0.04))"
  })

fn foregroundRail -> html.Html<Task<Unit>> =
  empty (html.style {
    position: "absolute",
    left: "14px",
    right: "14px",
    bottom: "8px",
    height: "18px",
    borderTop: "4px solid #4f4a41",
    borderBottom: "6px solid #302e2a",
    background: "#6a6255",
    boxShadow: "0 -4px 0 rgba(255,255,255,0.18)"
  })

pub fn view selected: Int
  -> nightMode: Bool
  -> select12: Task<Unit>
  -> select7: Task<Unit>
  -> select4: Task<Unit>
  -> select9: Task<Unit>
  -> select15: Task<Unit>
  -> html.Html<Task<Unit>> =
  html.div {
    style: html.style {
      position: "relative",
      width: "760px",
      height: "560px",
      marginLeft: "auto",
      marginRight: "auto",
      overflow: "hidden",
      border: "4px solid #302f2b",
      borderRadius: "5px",
      backgroundColor: if nightMode then "#d8c9ad" else "#eadcc3",
      backgroundImage: "linear-gradient(rgba(103,81,54,0.12) 1px, transparent 1px), linear-gradient(90deg, rgba(103,81,54,0.12) 1px, transparent 1px)",
      backgroundSize: "24px 24px",
      boxShadow: "inset 0 0 0 9px #817765, inset 0 0 45px rgba(65,45,29,0.14), 0 12px 28px rgba(0,0,0,0.32)"
    },
    children: [
      floorGlow (),

      sprite "22px" "23px" "48px" "104px" 0 0,
      sprite "88px" "22px" "192px" "106px" 0 116,
      sprite "302px" "22px" "150px" "106px" 200 116,
      sprite "594px" "22px" "110px" "104px" 416 0,

      sprite "27px" "190px" "200px" "104px" 208 0,
      sprite "250px" "199px" "110px" "104px" 536 0,
      sprite "385px" "177px" "110px" "106px" 358 116,
      sprite "506px" "177px" "110px" "106px" 358 116,
      sprite "631px" "182px" "138px" "112px" 476 116,

      sprite "82px" "374px" "138px" "106px" 622 116,
      sprite "345px" "373px" "166px" "112px" 768 116,
      sprite "526px" "439px" "144px" "104px" 56 0,

      wallLabel "90px" "7px" "ドリンク・冷蔵",
      wallLabel "307px" "7px" "お弁当・惣菜",
      wallLabel "35px" "173px" "レジカウンター",
      wallLabel "391px" "160px" "スナック・菓子",
      wallLabel "636px" "165px" "日用品・雑貨",
      wallLabel "88px" "356px" "雑誌・書籍",
      wallLabel "351px" "355px" "アイス・冷凍食品",

      clerk (),
      customer selected 12 "308px" "132px" 40 select12,
      customer selected 7 "559px" "130px" 80 select7,
      customer selected 4 "606px" "304px" 120 select4,
      customer selected 9 "307px" "306px" 160 select9,
      customer selected 15 "194px" "309px" 200 select15,

      foregroundRail ()
    ]
  }

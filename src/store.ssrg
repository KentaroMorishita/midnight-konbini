import * as html from "std/web/html"
import { view as legacyView } from "./store_legacy"

fn empty style: html.Style -> html.Html<Task<Unit>> =
  html.div { style, children: "" }

fn floorPatch left: String
  -> top: String
  -> width: String
  -> height: String
  -> nightMode: Bool
  -> html.Html<Task<Unit>> =
  empty (html.style {
    position: "absolute",
    left,
    top,
    width,
    height,
    zIndex: "20",
    backgroundColor: if nightMode then "#d8c9ad" else "#eadcc3",
    backgroundImage: "linear-gradient(rgba(103,81,54,0.12) 1px, transparent 1px), linear-gradient(90deg, rgba(103,81,54,0.12) 1px, transparent 1px)",
    backgroundSize: "24px 24px"
  })

fn snackShelf -> html.Html<Task<Unit>> =
  empty (html.style {
    position: "absolute",
    left: "372px",
    top: "239px",
    width: "144px",
    height: "48px",
    zIndex: "21",
    backgroundImage: "url('/sprites/fixtures/shelf_snack.png')",
    backgroundSize: "144px 48px",
    backgroundRepeat: "no-repeat",
    imageRendering: "pixelated",
    filter: "drop-shadow(0 5px 3px rgba(55,38,24,0.22))"
  })

fn clerk -> html.Html<Task<Unit>> =
  empty (html.style {
    position: "absolute",
    left: "126px",
    top: "222px",
    width: "48px",
    height: "96px",
    zIndex: "22",
    backgroundImage: "url('/sprites/characters/clerk_male_sheet.png')",
    backgroundSize: "144px 384px",
    backgroundPosition: "0px 0px",
    backgroundRepeat: "no-repeat",
    imageRendering: "pixelated",
    filter: "drop-shadow(0 4px 2px rgba(50,35,24,0.22))"
  })

pub fn view selected: Int
  -> nightMode: Bool
  -> select12: Task<Unit>
  -> select7: Task<Unit>
  -> select4: Task<Unit>
  -> select9: Task<Unit>
  -> select15: Task<Unit>
  -> html.Html<Task<Unit>> =
  html.div {
    style: html.style {
      position: "relative",
      width: "768px",
      height: "568px",
      marginLeft: "auto",
      marginRight: "auto"
    },
    children: [
      legacyView selected nightMode select12 select7 select4 select9 select15,

      floorPatch "389px" "181px" "110px" "106px" nightMode,
      snackShelf (),

      floorPatch "126px" "254px" "47px" "64px" nightMode,
      clerk ()
    ]
  }
